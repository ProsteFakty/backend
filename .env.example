# Copy to .env and fill in. Never commit .env.

# local | prod. Missing = prod (Swagger off).
APP_ENV=local

# Local only: loads docker-compose.local.yml (hot reload, port 8000).
# On the server delete this line and set APP_ENV=prod.
COMPOSE_FILE=docker-compose.yml:docker-compose.local.yml

POSTGRES_USER=prostefakty
POSTGRES_PASSWORD=change-me
POSTGRES_DB=prostefakty

GEMINI_API_KEY=

# Server only: S3 bucket for db/dump.sh backups.
BUCKET=
